# Copy to .env and fill in every value. `docker compose` refuses to start
# and names the variable if a required value is missing.

# Folder on the SSD that holds data/, config/ and custom_apps/ (owned by uid 33).
# For local development, use a folder inside the repo, e.g. ../dev-data/documents
DOCS_ROOT=/srv/media-vault/documents

# The tailnet host name you open in the browser, e.g. docs.<your-tailnet>.ts.net
DOCS_HOST=docs.your-tailnet.ts.net

# Database password for Nextcloud's PostgreSQL. Use a long random value.
POSTGRES_PASSWORD=

# The owner account. Only used on the very first start, when Nextcloud installs itself.
# Changing these later has no effect; change the password in Nextcloud instead.
NEXTCLOUD_ADMIN_USER=owner
NEXTCLOUD_ADMIN_PASSWORD=

# Tailscale: an auth key with the tag `tag:docs` (Tailscale admin console > Settings > Keys).
# Only needed for the first start; the node identity is then kept in the docs-ts volume,
# and you can revoke the key.
TS_AUTHKEY=
# Node name on the tailnet. The store is then at https://<TS_HOSTNAME>.<your-tailnet>.ts.net
# (must match DOCS_HOST).
TS_HOSTNAME=docs

# Country for phone numbers without a country code (ISO 3166-1, used by scripts/configure.sh).
DOCS_PHONE_REGION=DE

# Mount point of the external backup HDD (scripts/backup.sh refuses to run if it isn't mounted).
# Snapshots go to $BACKUP_MOUNT/media-vault/documents/.
BACKUP_MOUNT=/mnt/synapse-backup

# Local development only (docker-compose.dev.yml): port on 127.0.0.1.
DOCS_DEV_PORT=8081
